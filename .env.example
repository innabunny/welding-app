# Настройки этой машины. Скопировать в .env и заполнить:
#   Windows:  copy .env.example .env
#   macOS:    cp .env.example .env
# Файл .env в репозиторий не попадает — у каждой машины свой.
# Пароли баз здесь не задаются: они общие для разработки и лежат
# в docker-compose.yml.

# Адрес этого компьютера в сети цеха — чтобы портал открывался
# с других устройств. Пусто — портал открывается только на нём самом.
# Пример: PORTAL_HOST=192.168.1.10
PORTAL_HOST=

# Опрос узлов телеметрии по HTTP: 1 — включён, 0 — выключен.
# Узлы и их адреса берутся из справочника оборудования в портале.
POLL_NODES=1

# Через сколько секунд без дуги закрывать сеанс, если карту не убрали.
POLL_SESSION_IDLE_SECONDS=600

# Сколько раз в секунду опрашивать узел. Узел (ESP32) держит мало соединений
# и закрывает каждое после ответа: на 5 раз в секунду он начинает пропускать.
POLL_HZ=2

# Через сколько секунд без ответа узел считается «нет связи» (опрос по HTTP).
# Узел иногда подвисает на 2–3 секунды, поэтому меньше 5 не ставить.
POLL_OFFLINE_SECONDS=5

# Кому открыт брокер MQTT. 127.0.0.1 — только этому компьютеру (по умолчанию).
# 0.0.0.0 — всей сети: тогда узел подключится к брокеру и перестанет подвисать
# каждые 5 с. Брокер без пароля — только для стенда, не для цеха.
MQTT_BIND=127.0.0.1
